# Settings for `docker compose --env-file .env.docker up -d --build`
#   cp .env.docker.example .env.docker   (then fill in the values below; never commit .env.docker)

# ── Required ─────────────────────────────────────────────────────────────────
# Password of the bundled PostgreSQL. Use URL-safe characters (it goes into a connection URL):  openssl rand -hex 24
POSTGRES_PASSWORD=
# Signs the session tokens (at least 32 characters):  openssl rand -base64 48
AUTH_SECRET=

# ── First admin (recommended on the first run) ───────────────────────────────
# Created if it does not exist; an existing account with this e-mail is promoted to admin. Password: 10+ characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Web ──────────────────────────────────────────────────────────────────────
# Host port that serves the app.
APP_PORT=3000
# Public URL users type in the browser (used for e-mail links and the Google OAuth redirect).
APP_URL=http://localhost:3000
# Secure cookies are the safe default for production. "false" lets login work over plain http on a LAN address / Safari.
# Behind HTTPS (reverse proxy) set it to true.
COOKIE_SECURE=false
# true only behind a reverse proxy you control (enables per-IP rate limiting from X-Forwarded-For).
TRUST_PROXY=false

# ── Optional features ────────────────────────────────────────────────────────
# AI tutor and chart analyzer. There is no default model: set both or leave both empty (the tutor then reports "not configured").
ANTHROPIC_API_KEY=
AI_MODEL=
# Password recovery e-mails, e.g. smtp://user:pass@smtp.example.com:587. Empty = e-mails are not sent in production.
SMTP_URL=
EMAIL_FROM=US30 Trading Academy <no-reply@example.com>
# Sign in with Google (redirect URI: ${APP_URL}/api/auth/google/callback).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
