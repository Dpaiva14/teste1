# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/academy"

# ─── App / Auth ──────────────────────────────────────────────────────────────
# Public base URL of the app (used for OAuth redirect URIs and e-mail links).
APP_URL="http://localhost:3000"
# Secret used to sign session JWTs. REQUIRED. Generate with: openssl rand -base64 48
AUTH_SECRET=""

# Google OAuth (optional). Create credentials at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── E-mail (password recovery) ──────────────────────────────────────────────
# Without SMTP_URL the reset link is printed to the server console (development only).
EMAIL_FROM="US30 Trading Academy <no-reply@example.com>"
SMTP_URL=""

# ─── Market data ─────────────────────────────────────────────────────────────
# "demo" = synthetic, clearly labelled DEMO candles (default). Real providers plug in through the
# MarketDataProvider interface in src/lib/market-data — see docs/MARKET_DATA.md.
MARKET_DATA_PROVIDER="demo"
MARKET_DATA_API_KEY=""

# ─── AI Tutor & Chart Analyzer (optional) ────────────────────────────────────
# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=""
# Model id to use for the tutor and the chart analyzer (check your provider's model list).
AI_MODEL=""

# ─── Storage ─────────────────────────────────────────────────────────────────
# Where uploaded screenshots / PDFs are stored on disk. Use a persistent volume in production.
STORAGE_DIR="./storage"
